---
import browserSource from './browser.js?raw';
import type { DevtoolsConfig } from './core.js';

interface Props {
  config: DevtoolsConfig;
}

const { config } = Astro.props as Props;
const serializedConfig = JSON.stringify(config).replace(/</g, '\\u003c');
---
{!import.meta.env.PROD && (
  <>
    <foundation-devtools data-fd-config="foundation-devtools-config"></foundation-devtools>
    <script type="application/json" data-fd-config-json set:html={serializedConfig}></script>
    <script is:inline type="module" set:html={browserSource}></script>
  </>
)}
