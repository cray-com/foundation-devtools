---
import type { DevtoolsConfig } from './core.js';

interface Props {
  config: DevtoolsConfig;
}

const { config } = Astro.props as Props;
const serializedConfig = JSON.stringify(config).replace(/</g, '\\u003c');
---
{!import.meta.env.PROD && (
  <>
    <foundation-devtools data-fd-config="foundation-devtools-config"></foundation-devtools>
    <script type="application/json" data-fd-config-json set:html={serializedConfig}></script>
    <script>
      import { defineDevtoolsElement } from '@cray-com/foundation-devtools/element';

      const configScript = document.querySelector('[data-fd-config-json]');
      const host = document.querySelector('foundation-devtools[data-fd-config]');
      if (configScript && host) {
        const config = JSON.parse(configScript.textContent || '{}');
        host.replaceWith(defineDevtoolsElement(config));
        configScript.remove();
      }
    </script>
  </>
)}
